{
  "language_tool": {
    "disabled_rules": [
      "EN_QUOTES",
      "COMMA_PARENTHESIS_WHITESPACE",
      "WHITESPACE_RULE",
      "EN_UNPAIRED_BRACKETS",
      "UPPERCASE_SENTENCE_START"
    ],
    "language": "en-US"
  },
  
  "content_filters": {
    "exclude_lines_matching": [
      "^#", "^##", "^###", "^\\*\\*", "^\\*\\s",
      "^\\-\\s", "^\\d+\\.", "\\[IMPLEMENTED\\]",
      "\\[PLANNED\\]", "\\[WIP\\]", "\\[MAYBE\\]",
      "^```", "^    ", "^\\t", "^---", "^===",
      "^//", "^<!--", "^\\s*$"
    ]
  },
  
  "technical_vocabulary": [
    "PyLine", "JSON", "XML", "HTML", "PHP", "WIP", "API", "CLI", "GUI",
    "IDE", "SDK", "stdin", "stdout", "stderr", "regex", "config",
    "Python", "JavaScript", "Java", "C++", "Perl", "Ruby", "Lua",
    "Shell", "macros", "keybindings", "indentation", "parser", "lexer"
  ],
  
  "spellcheck": {
    "enabled": true,
    "max_suggestions": 5,
    "distance": 2,
    "ignore_patterns": [
      "^[A-Z]{2,}$",
      "^[A-Z][a-z]+[A-Z]\\w*$",
      "^\\d+$",
      "^0x[0-9a-fA-F]+$"
    ]
  },
  
  "output_settings": {
    "max_issues": 30,
    "show_statistics": true,
    "show_readability": true,
    "show_spelling": true,
    "show_writing_tips": true
  },
  
  "writing_tips": {
    "readability_threshold": 60,
    "sentence_length_ideal": [15, 20]
  }
}
